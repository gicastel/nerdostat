@page "/program"
@inherits ProgramBase

@if (status == null)
{
     <div class="jumbotron vertical-center">
          <div class="container text-center">
            <FluentProgressRing></FluentProgressRing>
        </div>
    </div>
}
else
{
    <div class="jumbotron vertical-center">
        <div class="container">
            @for (int i = 0; i < 7; i++)
            {
                <div id="chartContainer_@i" style="height: 370px; width: 100%;">
                    <canvas id="programChart_@i"></canvas>
                </div>
            }
        </div>
        <div>
            <FluentButton @onclick=@Save>Save</FluentButton>
            <FluentButton @onclick=@Reset>Reset</FluentButton>
        </div>
    </div>
}

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            for (int i = 0; i < 7; i++)
            {
                await JSRuntime.InvokeVoidAsync("renderEditableProgramChart", status, i);
            }
        }
    }
}