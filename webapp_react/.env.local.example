# Copy this file to .env.local and fill in your values

# Azure Functions API Base URL (without /api)
VITE_API_BASE_URL=

# Azure Functions API Key
VITE_API_KEY=
# Power BI Report URL (optional - falls back to default workspace if not set)
VITE_POWERBI_REPORT_URL=https://app.powerbi.com/groups/me/reports/your-report-id